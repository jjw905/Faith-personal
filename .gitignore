# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit (no .env.example exceptions)
.env*
backend/.env*
*.env.example
local.env.example

# local GCP Docker deploy configs (secrets stay in Secret Manager)
deploy.gcp.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local vault fallback storage
.data/

# playwright local capture logs
.playwright-cli/

# secrets / deploy keys (local only, never commit)
.secrets/
faith_team_do_ed25519
faith_team_do_ed25519.pub
*_do_ed25519
*_do_ed25519.pub

# Cursor / local agent docs
AGENTS.md
CLAUDE.md
.cursor/
.cursorrules
.cursorignore

# office docs (local only)
Faith-office/

# internal prototypes / ops scratch (not part of the product runtime)
/prototypes/
/ops/

# local infra runbooks (keep on disk, do not publish)
infra/**/*.md

# local word-focus verify media (generated by scripts/verify-word-focus.ts)
/public/dev/word-focus/*
!/public/dev/word-focus/play.html

/src/generated/prisma

# python
__pycache__/
*.pyc
.venv/
.venv-docx/
.venv-diarization/
.venv-stt/
venv/
.local-wip/
