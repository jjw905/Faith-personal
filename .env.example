# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Postgres (로컬: docker compose up -d)
DATABASE_URL=postgresql://faith:faith@localhost:5432/faith?schema=public

# OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# Resend 이메일 인증
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=Faith <onboarding@resend.dev>

# 콤마 구분. 해당 이메일로 첫 가입 시 ADMIN
ADMIN_EMAILS=you@example.com
ADMIN_SEED_PASSWORD=

# DigitalOcean Spaces (보관함/회의 업로드)
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=

# OpenAI (업로드 STT / 의미 정리)
OPENAI_API_KEY=

# 알림 등 로컬 밀봉 저장 키 (비우면 AUTH_SECRET 사용, 둘 다 없으면 .data/crypto 로컬 키)
NOTIFICATION_ENC_KEY=

