# Auth.js
AUTH_SECRET=
# 인증 앱에 표시할 서비스 이름
MFA_ISSUER=Faith
# 앱·메일 CTA 절대 URL 기준 (끝 / 없이). 프로덕션 예: https://dofaith.net
AUTH_URL=http://localhost:3000

# Server Actions 고정 키 (openssl rand -hex 32). BUILD+RUNTIME 동일 값.
# 코드에 넣지 말 것. 비우면 빌드마다 키가 바뀌어 롤링 배포 시 Action mismatch 가능.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# 진단/시드 API Bearer (openssl rand -hex 32). 없으면 setup·health 상세 사용 불가.
SETUP_SECRET=

# 팀 기록 보존 유지보수 스케줄러 Bearer (openssl rand -hex 32).
# POST /api/internal/maintenance/team-retention 에 사용. 관리자 화면 수동 실행은 별도 가능.
MAINTENANCE_CRON_SECRET=
# GCP Cloud Scheduler OIDC 검증. audience는 유지보수 route URL,
# service account는 Scheduler가 발급하는 ID token의 email과 일치해야 한다.
MAINTENANCE_CRON_AUDIENCE=
MAINTENANCE_CRON_SERVICE_ACCOUNT=

# 출시 스위치 (NEXT_PUBLIC 값은 브라우저에 공개되므로 비밀값을 넣지 말 것).
# 일반 사용자 팀 오픈: ADMIN_ONLY=false. 실시간 오픈: REALTIME=true.
NEXT_PUBLIC_TEAM_FEATURE_ENABLED=true
NEXT_PUBLIC_TEAM_FEATURE_ADMIN_ONLY=true
NEXT_PUBLIC_REALTIME_FEATURE_ENABLED=false
LIVEKIT_ENABLED=0

# Postgres (로컬: npm run dev / npm run db:up 이 Colima·Docker + migrate까지 처리)
DATABASE_URL=postgresql://faith:faith@localhost:5432/faith?schema=public
# 파일 서버 경로. 로컬은 기본 .data, 운영에서 Web·Worker가 같은 경로를 마운트한다.
FAITH_DATA_DIR=.data
# 운영 객체 저장소: local | s3 | gcs. 로컬은 local, GCP는 gcs.
STORAGE_BACKEND=local
# Google Cloud Storage (STORAGE_BACKEND=gcs일 때 사용, ADC는 Secret Manager/IAM으로 제공)
GCP_PROJECT_ID=
GCS_BUCKET=
GCS_SIGNED_URL_TTL_SECONDS=600
# 회의 결과·AI 운영 이벤트 저장: local | database. GCP Cloud Run은 database.
DURABLE_STATE_BACKEND=local
# 로컬은 inline, 운영 Web은 queue, Worker 프로세스는 analysis:workers로 실행한다.
ANALYSIS_EXECUTION_MODE=inline
ANALYSIS_WORKER_COUNT=2
ANALYSIS_WORKER_POLL_MS=1000

# OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# Google reCAPTCHA v3 (관리 콘솔 사이트 키 / 비밀 키)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Resend 이메일 인증 (support.dofaith.net DNS 인증 후 From 변경)
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=Faith <onboarding@resend.dev>
# 예: Faith <noreply@support.dofaith.net>

# 콤마 구분. 해당 이메일로 가입/로그인 시 ADMIN (개발전용 메뉴)
# 로컬: npm run db:up 또는 npm run db:admin
#   ADMIN_EMAILS 미설정 시 자동 생성:
#     email: faith-admin@faith.local
#     password: faith-dev-local
#     팀: 제품기획팀 대표 (+ 팀장·팀원 테스트 계정)
#   예시 일정·공지까지 채우려면: npm run seed:team-roles
ADMIN_EMAILS=you@example.com
ADMIN_SEED_PASSWORD=

# DigitalOcean Spaces (보관함/회의 업로드)
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=

# OpenAI (업로드 STT / 의미 정리)
OPENAI_API_KEY=

# 국립국어원 우리말샘, 실재어 보호와 발음 유사 추천
KOREAN_DICT_API_KEY=

# 화자분리. 기본은 공개 pyannote segmentation + 3D-Speaker 로컬 모델.
# Community-1을 선택할 때만 사용 조건 동의 후 HF_TOKEN 설정.
# 배포 서버에는 모델/가상환경이 없으면 자동으로 건너뛴다 (업로드는 전사만 완료).
# DIARIZATION_ENABLED=0 이면 강제로 끈다. DIARIZATION_PYTHON 으로 실행 파일 지정.
DIARIZATION_ENABLED=
DIARIZATION_PYTHON=
HF_TOKEN=
PYANNOTE_MODEL_PATH=
PYANNOTE_DEVICE=cpu
PYANNOTE_CLUSTER_THRESHOLD=0.9
# OpenAI 화자 턴 합의 실험. KTV 기준 안정화 전까지 제품 기본 경로에서는 끈다.
STT_SPEAKER_TURN_RECONCILE=0
# 한국어 Wav2Vec2 강제 정렬. 환경이 설치되어 있으면 기본 사용, 0이면 끔.
FORCED_ALIGNMENT_ENABLED=

# LiveKit (서버 전용 키, API secret은 클라이언트에 노출 금지)
LIVEKIT_URL=wss://rtc.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AWS KMS (기본 잠금. 운영 환경에서만 ENABLED=1, RUNTIME_ENV=production)
# 팀 보안 키 생성 IAM: kms:CreateKey, kms:TagResource, kms:DescribeKey
# 생성 후 데이터 사용 IAM: 생성된 키 ARN에 kms:Encrypt, kms:Decrypt, kms:GenerateDataKey
AWS_KMS_ENABLED=0
AWS_KMS_RUNTIME_ENV=local
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_KMS_CONTENT_KEY_ARN=
AWS_KMS_AUDIT_KEY_ARN=

# Google Cloud KMS (GCP 운영에서 사용. 기본 잠금)
GCP_KMS_ENABLED=0
GCP_KMS_RUNTIME_ENV=local
GCP_KMS_LOCATION=asia-northeast3
GCP_KMS_KEY_RING=faith
GCP_KMS_CONTENT_KEY=faith-content
GCP_KMS_AUDIT_KEY=faith-audit
GCP_KMS_TEAM_KEY_RING=faith-teams

# 알림 등 로컬 밀봉 저장 키 (비우면 AUTH_SECRET 사용, 둘 다 없으면 .data/crypto 로컬 키)
NOTIFICATION_ENC_KEY=

# 프록시 뒤에서만 1. X-Forwarded-For / X-Real-IP / True-Client-IP 신뢰.
# 신뢰하는 Cloudflare/리버스 프록시 뒤에서만 true. 직접 오리진이 외부에
# 노출된 상태에서는 비워 두어 전달 IP 헤더 위조를 막음.
TRUST_PROXY=

# Next Server Actions 허용 origin (호스트[:포트] 콤마 구분, 빌드와 런타임에 동일하게 설정)
NEXT_SERVER_ACTION_ALLOWED_ORIGINS=localhost:3000,localhost:3001,dofaith.net,www.dofaith.net

