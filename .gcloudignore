# Prefer an explicit upload set for the Cloud Build Docker context. When this
# file exists, gcloud does NOT also apply .gitignore.
.gcloudignore
.git
.github
/.cursor/
/.data/
/.local-wip/
/.playwright-cli/
/.secrets/
/.venv/
/.venv-*/
**/.venv/**
/ml/
/docs/
/infra/
/prototypes/
/ops/
/Faith-office/
/coverage/
/node_modules/
/.next/
*.log
*.pem
*.key
*.pub
.env
.env.*
!.env.example
!.local.env.example
gha-creds-*.json
tsconfig.tsbuildinfo
