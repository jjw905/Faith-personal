{
  "name": "faith-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "cacheDirectories": [
    ".next/cache",
    "node_modules"
  ],
  "scripts": {
    "dev:stop": "bash scripts/stop-dev.sh",
    "dev:prepare": "bash scripts/ensure-next-swc.sh",
    "db:up": "bash scripts/ensure-local-db.sh",
    "db:admin": "npx tsx scripts/ensure-local-admin.ts",
    "dev": "npm run dev:stop && npm run db:up && npm run dev:prepare && next dev --hostname 0.0.0.0 --port 3000",
    "dev:reset": "npm run dev:stop && rm -rf .next && npm run db:up && npm run dev:prepare && next dev --hostname 0.0.0.0 --port 3000",
    "clean": "rm -rf .next",
    "postinstall": "prisma generate && bash scripts/ensure-next-swc.sh",
    "build": "prisma generate && next build",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "seed:team-roles": "npx tsx scripts/seed-team-role-users.ts",
    "start": "prisma migrate deploy && next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "lint": "eslint",
    "test:team": "npx tsx --tsconfig tsconfig.json scripts/test-team-permissions.ts",
    "test:team:policy": "npx tsx --tsconfig tsconfig.json scripts/test-team-permissions.ts",
    "test:kms-policy": "npx tsx --tsconfig tsconfig.json scripts/test-kms-runtime-policy.ts",
    "test:masking": "npx --yes tsx --tsconfig tsconfig.json scripts/test-masking.ts",
    "test:masking:random": "npx --yes tsx --tsconfig tsconfig.json scripts/test-random-masking.ts",
    "diarization:setup": "bash scripts/setup-diarization.sh",
    "test:realtime:diarization": "DIARIZATION=pyannote MAX_SEC=${MAX_SEC:-60} npx tsx --tsconfig tsconfig.json scripts/eval-realtime-pipeline.ts",
    "test:stt:terms": "tsx --tsconfig tsconfig.json scripts/test-term-suggest-product.ts",
    "eval:stt:public": "tsx --tsconfig tsconfig.json scripts/eval-stt-public-60.ts",
    "prepare:stt:kmsav": "tsx --tsconfig tsconfig.json scripts/prepare-kmsav-benchmark.ts",
    "eval:stt:daily": "tsx --tsconfig tsconfig.json scripts/eval-stt-daily-video.ts",
    "bench:stt:alignment": "tsx --tsconfig tsconfig.json scripts/benchmark-korean-alignment.ts",
    "bench:stt:server": "tsx --tsconfig tsconfig.json scripts/benchmark-stt-server.ts",
    "seed:stt-bench": "bash scripts/seed-stt-bench.sh",
    "seed:kmsav-eval-meetings": "tsx --tsconfig tsconfig.json scripts/seed-kmsav-eval-meetings.ts",
    "stt:extract-timed": "python3 scripts/extract-timed-segments.py",
    "train:pii-ner:smoke": "bash ml/pii-ner/run.sh smoke",
    "train:pii-ner": "bash ml/pii-ner/run.sh full",
    "ner:serve": "bash ml/pii-ner/serve.sh"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@livekit/components-react": "^2.9.23",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-slot": "^1.3.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^4.104.0",
    "pretendard": "^1.3.9",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.1"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
