{
  "name": "faith-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "cacheDirectories": [
    ".next/cache",
    "node_modules"
  ],
  "scripts": {
    "dev:stop": "bash scripts/stop-dev.sh",
    "dev:prepare": "bash scripts/ensure-next-swc.sh",
    "db:up": "bash scripts/ensure-local-db.sh",
    "db:admin": "bash scripts/with-local-secrets.sh -- npx tsx scripts/ensure-local-admin.ts",
    "dev": "bash scripts/with-local-secrets.sh -- npm run dev:with-secrets",
    "dev:with-secrets": "bash scripts/run-dev-with-worker.sh",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:reset": "npm run dev -- --reset-next",
    "analysis:worker": "NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.json scripts/analysis-worker.ts",
    "analysis:workers": "bash scripts/run-analysis-workers.sh",
    "clean": "rm -rf .next",
    "postinstall": "prisma generate && bash scripts/ensure-next-swc.sh",
    "build": "prisma generate && next build",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "migrate:local-durable-state": "tsx --tsconfig tsconfig.json scripts/migrate-local-durable-state.ts",
    "test:gcp-runtime": "tsx --tsconfig tsconfig.json scripts/verify-gcp-runtime.ts",
    "seed:team-roles": "npx tsx scripts/seed-team-role-users.ts",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "lint": "eslint",
    "security:secrets": "node scripts/check-secret-hygiene.mjs",
    "deploy:gcp": "bash scripts/deploy-gcp-docker.sh",
    "deploy:gcp:staging": "bash scripts/deploy-gcp-docker.sh staging",
    "deploy:gcp:production": "bash scripts/deploy-gcp-docker.sh production",
    "test:team": "npx tsx --tsconfig tsconfig.json scripts/test-team-permissions.ts",
    "test:team:encryption": "npx tsx --tsconfig tsconfig.json scripts/test-team-encryption.ts",
    "test:team:encryption:large": "npx tsx --tsconfig tsconfig.json scripts/test-team-encryption.ts --large",
    "test:team:policy": "npx tsx --tsconfig tsconfig.json scripts/test-team-permissions.ts",
    "test:team:launch": "npx tsx --tsconfig tsconfig.json scripts/test-team-launch-readiness.ts",
    "test:team:retention": "npx tsx --tsconfig tsconfig.json scripts/test-team-retention.ts",
    "test:realtime:policy": "npx tsx --tsconfig tsconfig.json scripts/test-realtime-policy.ts",
    "test:kms-policy": "npx tsx --tsconfig tsconfig.json scripts/test-kms-runtime-policy.ts",
    "test:sidebar-layout": "npx tsx --tsconfig tsconfig.json scripts/test-sidebar-layout.ts",
    "test:desktop-layout-floor": "npx tsx --tsconfig tsconfig.json scripts/test-desktop-layout-floor.ts",
    "test:chat-replay-header": "npx tsx --tsconfig tsconfig.json scripts/test-chat-replay-header-layout.ts",
    "test:chat-bubble-edit": "npx tsx --tsconfig tsconfig.json scripts/test-chat-bubble-edit.ts",
    "test:meeting-detail-align": "npx tsx --tsconfig tsconfig.json scripts/test-meeting-detail-section-align.ts",
    "test:masking": "npx --yes tsx --tsconfig tsconfig.json scripts/test-masking.ts",
    "test:masking:random": "npx --yes tsx --tsconfig tsconfig.json scripts/test-random-masking.ts",
    "test:process-progress": "npx tsx --tsconfig tsconfig.json scripts/verify-process-progress-anim.ts",
    "test:meeting-export": "npx tsx --tsconfig tsconfig.json scripts/verify-meeting-export.ts",
    "test:analysis-usage": "npx tsx --tsconfig tsconfig.json scripts/test-analysis-usage.ts",
    "test:analysis-policy": "npx tsx --tsconfig tsconfig.json scripts/test-analysis-policy.ts",
    "test:analysis-lifecycle": "npx tsx --tsconfig tsconfig.json scripts/test-analysis-lifecycle.ts",
    "test:realtime-speaker-clusters": "NODE_OPTIONS=--conditions=react-server npx tsx --tsconfig tsconfig.json scripts/test-realtime-speaker-clusters.ts",
    "test:transcript-evidence": "npx tsx --tsconfig tsconfig.json scripts/test-transcript-evidence.ts",
    "test:analysis-diagnostics": "npx tsx --tsconfig tsconfig.json scripts/test-analysis-diagnostics.ts",
    "eval:meeting-quality-gate": "npx tsx --tsconfig tsconfig.json scripts/eval-meeting-quality-gate.ts",
    "eval:video-hardset": "npx tsx --tsconfig tsconfig.json scripts/eval-video-hardset.ts",
    "eval:product-transcript-quality": "npx tsx --tsconfig tsconfig.json scripts/eval-product-transcript-quality.ts",
    "eval:ktv-run-history": "npx tsx --tsconfig tsconfig.json scripts/eval-ktv-run-history.ts",
    "eval:speech-model-ledger": "npx tsx --tsconfig tsconfig.json scripts/eval-speech-model-ledger.ts",
    "eval:community1-generalization": "npx tsx --tsconfig tsconfig.json scripts/eval-community1-generalization.ts",
    "ops:encryption-rotation": "NODE_OPTIONS=--conditions=react-server npx tsx --tsconfig tsconfig.json scripts/rotate-team-encryption-v1.ts",
    "diarization:setup": "bash scripts/setup-diarization.sh",
    "alignment:setup": "bash scripts/setup-alignment.sh",
    "test:realtime:diarization": "DIARIZATION=pyannote MAX_SEC=${MAX_SEC:-60} npx tsx --tsconfig tsconfig.json scripts/eval-realtime-pipeline.ts",
    "test:stt:terms": "tsx --tsconfig tsconfig.json scripts/test-term-suggest-product.ts",
    "eval:stt:public": "tsx --tsconfig tsconfig.json scripts/eval-stt-public-60.ts",
    "prepare:stt:kmsav": "tsx --tsconfig tsconfig.json scripts/prepare-kmsav-benchmark.ts",
    "eval:stt:daily": "tsx --tsconfig tsconfig.json scripts/eval-stt-daily-video.ts",
    "bench:stt:alignment": "tsx --tsconfig tsconfig.json scripts/benchmark-korean-alignment.ts",
    "bench:stt:server": "tsx --tsconfig tsconfig.json scripts/benchmark-stt-server.ts",
    "seed:stt-bench": "bash scripts/seed-stt-bench.sh",
    "seed:kmsav-eval-meetings": "tsx --tsconfig tsconfig.json scripts/seed-kmsav-eval-meetings.ts",
    "stt:extract-timed": "python3 scripts/extract-timed-segments.py",
    "train:pii-ner:smoke": "bash ml/pii-ner/run.sh smoke",
    "train:pii-ner": "bash ml/pii-ner/run.sh full",
    "ner:serve": "bash ml/pii-ner/serve.sh"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-kms": "^3.1100.0",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@google-cloud/kms": "^5.7.0",
    "@google-cloud/storage": "^7.21.0",
    "@livekit/components-react": "^2.9.23",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-slot": "^1.3.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "google-auth-library": "^11.0.0",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^1.23.0",
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^4.104.0",
    "otplib": "^13.4.1",
    "pdf-lib": "^1.17.1",
    "pretendard": "^1.3.9",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "ws": "^8.21.1"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
