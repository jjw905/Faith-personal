{
  "name": "secure-meeting-minutes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:stop": "bash scripts/stop-dev.sh",
    "dev": "npm run dev:stop && next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "lint": "eslint",
    "test:masking": "npx --yes tsx --tsconfig tsconfig.json scripts/test-masking.ts",
    "test:masking:random": "npx --yes tsx --tsconfig tsconfig.json scripts/test-random-masking.ts",
    "train:pii-ner:smoke": "bash ml/pii-ner/run.sh smoke",
    "train:pii-ner": "bash ml/pii-ner/run.sh full",
    "ner:serve": "bash ml/pii-ner/serve.sh"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
