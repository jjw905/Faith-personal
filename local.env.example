# 로컬 실행용 안전한 오버레이.
# 이 파일에는 실제 키를 넣지 말고, 필요한 비밀값은 .env.local에 별도로 입력합니다.

AUTH_URL=http://localhost:3001
MFA_ISSUER=Faith (Local)
DATABASE_URL=postgresql://faith:faith@127.0.0.1:55432/faith?schema=public
FAITH_DATA_DIR=.data
STORAGE_BACKEND=local
GCP_PROJECT_ID=
GCS_BUCKET=
GCS_SIGNED_URL_TTL_SECONDS=600
DURABLE_STATE_BACKEND=local
ANALYSIS_EXECUTION_MODE=queue
ANALYSIS_WORKER_COUNT=2
ANALYSIS_WORKER_POLL_MS=1000

# 로컬은 팀 UI를 확인할 수 있게 켜되, 실시간 STT는 외부 LiveKit 연결 없이 끕니다.
NEXT_PUBLIC_TEAM_FEATURE_ENABLED=true
NEXT_PUBLIC_TEAM_FEATURE_ADMIN_ONLY=true
NEXT_PUBLIC_REALTIME_FEATURE_ENABLED=false
LIVEKIT_ENABLED=0

# 로컬에서 운영 KMS·Spaces·LiveKit을 사용하지 않습니다.
AWS_KMS_ENABLED=0
AWS_KMS_RUNTIME_ENV=local
GCP_KMS_ENABLED=0
GCP_KMS_RUNTIME_ENV=local
GCP_KMS_LOCATION=asia-northeast3
GCP_KMS_KEY_RING=
GCP_KMS_CONTENT_KEY=
GCP_KMS_AUDIT_KEY=
GCP_KMS_TEAM_KEY_RING=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TRUST_PROXY=
NEXT_SERVER_ACTION_ALLOWED_ORIGINS=localhost:3001

# 로컬 인증용 값은 별도로 설정하세요.
# AUTH_SECRET=
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
